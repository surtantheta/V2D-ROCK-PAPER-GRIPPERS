#!/bin/bash
#PBS -N v2d_joint_prefl1
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -k doe
set -euo pipefail
TASK_ROOT=/rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/joint_kaggle_20261031
exec > "$TASK_ROOT/logs/preflight_${PBS_JOBID%%.*}.log" 2>&1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export XDG_CACHE_HOME=/rhome/tanuj/v2d_joint_kaggle_20261031/cache
cd "$TASK_ROOT"
/home/tanuj/.conda/envs/v2d/bin/python -I -B -u "$TASK_ROOT/code/preflight_v1.py" --out "$TASK_ROOT/preflight/INITIAL_PREFLIGHT.json"
