#!/bin/bash
#PBS -N v2d_pp_fill
#PBS -q workq
#PBS -l select=1:ncpus=4:mem=24gb:host=cvml11
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -o /rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/physics_pp_20261101/logs/fill_pbs.log
# Usage: qsub -v LAM_O=1000,TAG=sm_o1000_h0,EPS="0 1 2" fill_v2.pbs  (smoothing only; then merge + validate)
S=/rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/physics_pp_20261101
exec > "$S/logs/fill_${TAG}_${PBS_JOBID%%.*}.log" 2>&1
set -u
echo "host $(hostname) start $(date -Is) job $PBS_JOBID"; sha256sum "$S/code/physics_pp_v2.py" "$S/code/merge_parquet.py" "$S/code/validate_parquet.py"
export OMP_NUM_THREADS=4 NUMBA_NUM_THREADS=4 PYTHONNOUSERSITE=1 NUMBA_CACHE_DIR=/rhome/tanuj/v2d_physics_pp_20261101/numba_cache
PY=/home/tanuj/.conda/envs/cari4d/bin/python
IN=/rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/joint_kaggle_20261031/ready_v2/track1_pi3x_joint_physics.parquet
O=/rhome/tanuj/v2d_physics_pp_20261101/$TAG
for e in $EPS; do
  $PY -I -u "$S/code/physics_pp_v2.py" --parquet "$IN" --episode $e --lam-object "$LAM_O" --lam-human 0 --no-clearance --out "$O/episodes" || { echo "episode $e failed"; exit 1; }
done
$PY -I -u "$S/code/merge_parquet.py" --parquet "$IN" --episodes-dir "$O/episodes" --out "$O/track1_physics_pp_${TAG}.parquet" || exit 1
$PY -I -u "$S/code/validate_parquet.py" --parquet "$O/track1_physics_pp_${TAG}.parquet" --source "$IN" --episodes-dir "$O/episodes" --out "$O/VALIDATION.json"
echo "exit $? end $(date -Is)"
