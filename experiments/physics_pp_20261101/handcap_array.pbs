#!/bin/bash
#PBS -N v2d_handcap
#PBS -q workq
#PBS -l select=1:ncpus=2:mem=12gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -J 0-29
#PBS -o /rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/physics_pp_20261101/logs/handcap_pbs.log
# Usage: qsub -v START=hs100f_o3e5,TAG=hc_hs100f,ARGS="--lam 100 --cap-rad 0.25 --free-first" handcap_array.pbs
S=/rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/physics_pp_20261101
exec > "$S/logs/handcap_${TAG}_${PBS_ARRAY_INDEX}.log" 2>&1
set -u
echo "host $(hostname) start $(date -Is) job $PBS_JOBID"; sha256sum "$S/code/hand_param_smooth.py" "$S/code/human_smooth.py" "$S/code/physics_pp_v2.py"
export OMP_NUM_THREADS=2 NUMBA_NUM_THREADS=2 PYTHONNOUSERSITE=1 NUMBA_CACHE_DIR=/rhome/tanuj/v2d_physics_pp_20261101/numba_cache
IN=/rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/joint_kaggle_20261031/ready_v2/track1_pi3x_joint_physics.parquet
B=/rhome/tanuj/v2d_physics_pp_20261101; e=$PBS_ARRAY_INDEX
/home/tanuj/.conda/envs/cari4d/bin/python -I -u "$S/code/hand_param_smooth.py" --parquet "$IN" --episode $e \
  --start "$(printf "$B/$START/episodes/episode_%06d.npz" $e)" --out "$B/$TAG" ${ARGS:-}
echo "exit $? end $(date -Is)"
