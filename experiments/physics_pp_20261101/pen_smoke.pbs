#!/bin/bash
#PBS -N v2d_pen_smoke
#PBS -q workq
#PBS -l select=1:ncpus=8:mem=64gb:host=cvml10
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/physics_pp_20261101/logs/pen_smoke_pbs.log
# Usage: qsub -v EP=22,START=sm_o4000_h0,TAG=pen_smoke_v1,ARGS="" pen_smoke.pbs
S=/rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/physics_pp_20261101
exec > "$S/logs/${TAG}_ep${EP}_${PBS_JOBID%%.*}.log" 2>&1
set -u
echo "host $(hostname) start $(date -Is) job $PBS_JOBID"; sha256sum "$S/code/pen_clear.py" "$S/code/physics_pp_v2.py"
export OMP_NUM_THREADS=8 NUMBA_NUM_THREADS=8 PYTHONNOUSERSITE=1 NUMBA_CACHE_DIR=/rhome/tanuj/v2d_physics_pp_20261101/numba_cache
IN=/rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/joint_kaggle_20261031/ready_v2/track1_pi3x_joint_physics.parquet
B=/rhome/tanuj/v2d_physics_pp_20261101
/home/tanuj/.conda/envs/cari4d/bin/python -I -u "$S/code/pen_clear.py" --parquet "$IN" --episode $EP \
  --start "$(printf "$B/$START/episodes/episode_%06d.npz" $EP)" --out "$B/$TAG" ${ARGS}
echo "exit $? end $(date -Is)"
