#!/bin/bash
#PBS -N v2d_smoke_hand
#PBS -q workq
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/physics_pp_20261101/logs/smoke_hand_pbs.log
# Smoke test of human_smooth.py --lam-hand on two short episodes: default path must reproduce hs100f_o3e5 exactly.
S=/rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/physics_pp_20261101
exec > "$S/logs/smoke_hand_${PBS_JOBID%%.*}.log" 2>&1
set -u
echo "host $(hostname) start $(date -Is) job $PBS_JOBID"; sha256sum "$S/code/human_smooth.py" "$S/code/physics_pp_v2.py"
export OMP_NUM_THREADS=8 NUMBA_NUM_THREADS=8 PYTHONNOUSERSITE=1 NUMBA_CACHE_DIR=/rhome/tanuj/v2d_physics_pp_20261101/numba_cache
PY=/home/tanuj/.conda/envs/cari4d/bin/python
IN=/rhome/tanuj/home_moved_20261029/V2D_challenge/experiments/joint_kaggle_20261031/ready_v2/track1_pi3x_joint_physics.parquet
B=/rhome/tanuj/v2d_physics_pp_20261101; O=$B/hand_smoke_v2
for e in 13 14; do
  st=$(printf "$B/sm_o300000_h0/episodes/episode_%06d.npz" $e)
  $PY -I -u "$S/code/human_smooth.py" --parquet "$IN" --episode $e --lam 100 --free-first --start "$st" --out "$O/default" > /dev/null || exit 1
  for lh in 30 100 300 1000; do
    $PY -I -u "$S/code/human_smooth.py" --parquet "$IN" --episode $e --lam 100 --free-first --lam-hand $lh --start "$st" --out "$O/lh$lh" > /dev/null || exit 1
  done
done
$PY -I - "$B" <<'PY'
import json, sys
import numpy as np
B = sys.argv[1]
for e in (13, 14):
    f = f'episode_{e:06d}'
    ref, new = np.load(f'{B}/hs100f_o3e5/episodes/{f}.npz'), np.load(f'{B}/hand_smoke_v2/default/{f}.npz')
    print(e, 'default path identical to hs100f_o3e5:', all(np.array_equal(ref[k], new[k]) for k in ref.files))
    for lh in (30, 100, 300, 1000):
        j = json.load(open(f'{B}/hand_smoke_v2/lh{lh}/{f}.json'))
        print(e, lh, {k: round(j[k], 5) for k in ('own_acc_hand_vertices_before', 'own_acc_hand_vertices_after',
                                                  'hand_vertex_change_cm_mean', 'own_acc_h_after')})
PY
echo "exit $? end $(date -Is)"
