#!/usr/bin/env bash
#PBS -N v2d_gpu
#PBS -l select=1:ncpus=4:mem=24gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
# usage: qsub -v CMD="..." gpu_task.pbs
exec > /home/tanuj/V2D_challenge/logs/gpu_${PBS_JOBID%%.*}.log 2>&1
export PYTHONNOUSERSITE=1
echo "host=$(hostname) gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader|head -1) start=$(date -Is)"
eval "$CMD"
echo "done=$(date -Is)"
