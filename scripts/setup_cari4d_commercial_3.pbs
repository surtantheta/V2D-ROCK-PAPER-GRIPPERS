#!/usr/bin/env bash
#PBS -N v2d_c4dc_env3
#PBS -l select=1:ncpus=12:mem=48gb
#PBS -l walltime=04:00:00
#PBS -j oe
exec > /home/tanuj/V2D_challenge/logs/setup_cari4d_commercial_3.log 2>&1
set -uo pipefail
ROOT=/home/tanuj/V2D_challenge
M=$ROOT/video_to_data/reconstruction/modules
VENV=/home/tanuj/envs/cari4dcom; PY=$VENV/bin/python
WTS=$ROOT/models/cari4d_commercial_weights
export PYTHONNOUSERSITE=1 PIP_CONFIG_FILE=/dev/null TORCH_CUDA_ARCH_LIST="7.5;8.6" FORCE_CUDA=1 MAX_JOBS=8 CUDA_HOME=/home/tanuj/.conda/envs/cari4d
export PATH=/home/tanuj/.conda/envs/cari4d/bin:$PATH
echo "host=$(hostname) start=$(date -Is)"
FP=$M/v2d_foundation_pose/lib/FoundationPose
B=/home/tanuj/envs/boost_1_83_0; EIG=/home/tanuj/envs/eigen-3.4.0
# 1) mycpp with header-only Boost + Eigen include dir
BLD=/home/tanuj/envs/build_mycpp; rm -rf $BLD; cp -r $FP/mycpp $BLD; rm -rf $BLD/build
python3 - "$BLD/CMakeLists.txt" "$EIG" <<'PYP'
import sys
p, eig = sys.argv[1], sys.argv[2]; s = open(p).read()
s = s.replace("find_package(Boost REQUIRED COMPONENTS system program_options)", "find_package(Boost REQUIRED)")
s = s.replace("find_package(Eigen3 REQUIRED)", f"set(EIGEN3_INCLUDE_DIR {eig})")
s = s.replace("include_directories(\n  include", "include_directories(\n  include\n  ${EIGEN3_INCLUDE_DIR}\n  ${Boost_INCLUDE_DIRS}")
s = s.replace("${Boost_LIBRARIES} ${OpenMP_CXX_FLAGS} Eigen3::Eigen", "${OpenMP_CXX_FLAGS}")
open(p, "w").write(s)
PYP
PB=$($PY -c "import pybind11;print(pybind11.get_cmake_dir())")
mkdir -p $BLD/build && cd $BLD/build && $VENV/bin/cmake .. -DPYTHON_EXECUTABLE=$PY -Dpybind11_DIR=$PB -DBOOST_ROOT=$B -DBoost_INCLUDE_DIR=$B 2>&1 | grep -iE "error|Found Boost" | head -5
make -j8 2>&1 | grep -E "error|Error|Built target" | head -10
mkdir -p $FP/mycpp/build && cp $BLD/build/mycpp*.so $FP/mycpp/build/ && echo "mycpp .so installed"
cd $FP && $PY -c "import sys; sys.path.insert(0,'.'); import mycpp.build.mycpp as m; print('mycpp import ok', [x for x in dir(m) if not x.startswith('_')])"
# 2) mycuda in place, full error output kept
cd $FP/bundlesdf/mycuda && rm -rf build && $PY setup.py build_ext --inplace 2>&1 | grep -E "error|Error|copying|\.so" | head -20
ls $FP/bundlesdf/mycuda/*.so 2>&1
cd $FP && $PY -c "import sys; sys.path.insert(0,'.'); from bundlesdf.mycuda import common; import gridencoder; print('mycuda ok')" 2>&1 | tail -2
# 3) weights (token read from the standard cache file, never printed)
export HF_HUB_OFFLINE=0 HF_HOME=$WTS/hf_home HF_TOKEN="$(cat /home/tanuj/.cache/huggingface/token)"
$PY -c "from v2d.cari4d.lib.download_weights import download_weights; r=download_weights('$WTS'); print({k:str(v)[-60:] for k,v in r.items()})" 2>&1 | tail -4
du -sh $WTS
echo "done=$(date -Is)"
